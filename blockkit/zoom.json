        { "type": "section", "fields": [
          { "type": "mrkdwn", "text": "*Host:*\nFrank Reynolds" },
          { "type": "mrkdwn", "text": "*Duration:*\n47 min" },
          { "type": "mrkdwn", "text": "*Recorded:*\nToday" },
          { "type": "mrkdwn", "text": "*Participants:*\n6" }
        ] },
        { "type": "context", "elements": [
          { "type": "mrkdwn", "text": "AI Companion summary & transcript available in Zoom" }
        ] },
        { "type": "actions", "elements": [
          { "type": "button", "text": { "type": "plain_text", "text": "View Recording", "emoji": true }, "url": "https://us02web.zoom.us/rec/share/acme-qbr", "action_id": "zoom_view_recording" }
