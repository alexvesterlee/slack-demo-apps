        { "type": "header", "text": { "type": "plain_text", "text": "📅 Upcoming Zoom Meeting", "emoji": true } },
        { "type": "section", "text": { "type": "mrkdwn", "text": "*Acme Corp — Quarterly Business Review*" } },
        { "type": "section", "fields": [
          { "type": "mrkdwn", "text": "*When:*\nToday · 2:00–2:30 PM PT" },
          { "type": "mrkdwn", "text": "*Host:*\nFrank Reynolds" },
          { "type": "mrkdwn", "text": "*Meeting ID:*\n852 1234 5678" },
          { "type": "mrkdwn", "text": "*Passcode:*\n418823" }
        ] },
        { "type": "actions", "elements": [
          { "type": "button", "text": { "type": "plain_text", "text": "Join Meeting", "emoji": true }, "style": "primary", "url": "https://us02web.zoom.us/j/85212345678", "action_id": "zoom_join" }
        ] }
      ]
    },
    {
