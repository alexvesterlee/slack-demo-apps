                "type": "plain_text",
                "text": "Add a Note",
                "emoji": true
              },
              "action_id": "pd_note",
              "value": "note"
            },
            {
              "type": "static_select",
              "placeholder": {
                "type": "plain_text",
                "text": "More actions",
                "emoji": true
              },
              "action_id": "pd_more",
              "options": [
                {
                  "text": {
                    "type": "plain_text",
                    "text": "Reassign"
                  },
                  "value": "reassign"
                },
                {
                  "text": {
                    "type": "plain_text",
                    "text": "Change urgency"
                  },
                  "value": "urgency"
                },
                {
                  "text": {
                    "type": "plain_text",
                    "text": "Run a response play"
                  },
                  "value": "response_play"
                },
                {
                  "text": {
                    "type": "plain_text",
                    "text": "View in PagerDuty"
                  },
                  "value": "view"
                }
              ]
            }
          ]
        },
        {
          "type": "context",
          "elements": [
            {
              "type": "mrkdwn",
              "text": "Dedicated incident channel created by <https://pagerduty.com|Jennifer Hynes> (@Pav) | October 21st, 2025 at 11:29 AM"
            }
          ]
        }
      ]
    },
