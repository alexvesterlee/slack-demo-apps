{
  "app": "PagerDuty",
  "fake_bot_id": "PagerDuty",
  "notes": "PagerDuty incident notifications, matched to the REAL Slack app layout (verified against a live PagerDuty message 2026-08). Fidelity rules: (1) the title is a status-emoji + a bold mrkdwn LINK in a `section` \u2014 NOT a `header` block; (2) fields are a single-column `*Label:* value` list in one mrkdwn section (Assigned / Type / Service / Urgency), not a two-column fields[] grid; (3) an `actions` row of real buttons \u2014 Resolve, Acknowledge, Add a Note \u2014 plus a trailing `static_select` placeholder 'More actions'; (4) a `context` footer like 'Dedicated incident channel created by <person> | <date>'. Urgency shows an \u2191/\u2193 arrow. Pair the Triggered card with a Resolved card. Post as the PagerDuty app via chat:write.customize with icon_url = <LOGO_BASE>/pagerduty.png.",
  "examples": [
    {
      "name": "incident_triggered",
      "when": "A monitor/alert opens an incident and pages the on-call; posted to a dedicated incident channel.",
      "blocks": [
        {
          "type": "section",
          "text": {
            "type": "mrkdwn",
            "text": ":large_yellow_circle:  *<https://pagerduty.com|Welo Guard App taking too long to load>*"
          }
        },
        {
          "type": "section",
          "text": {
            "type": "mrkdwn",
            "text": "*Assigned:* <https://pagerduty.com|Jennifer Hynes>\n*Type:* Base Incident\n*Service:* <https://pagerduty.com|Welo Guard>\n*Urgency:* \u2191 High"
          }
        },
        {
          "type": "actions",
          "elements": [
            {
              "type": "button",
              "text": {
                "type": "plain_text",
                "text": "Resolve",
                "emoji": true
              },
              "action_id": "pd_resolve",
              "value": "resolve"
            },
            {
              "type": "button",
              "text": {
                "type": "plain_text",
                "text": "Acknowledge",
                "emoji": true
              },
              "action_id": "pd_ack",
              "value": "ack"
